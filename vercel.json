{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|downloads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/iocf-data",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/iocf-data.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/downloads/IOCF.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"IOCF.apk\""
        }
      ]
    }
  ],
  "functions": {
    "api/iocf-data.mjs": {
      "maxDuration": 30,
      "includeFiles": "iocf.config.json"
    },
    "api/command/[...path].mjs": {
      "maxDuration": 15,
      "includeFiles": "src/data/commandCenter/**"
    }
  }
}
