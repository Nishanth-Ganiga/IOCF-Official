{
  "rewrites": [
    {
      "source": "/api/command/:path*",
      "destination": "/api/command-center?p=:path*"
    },
    {
      "source": "/((?!api/|assets/|downloads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/iocf-data",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/iocf-data.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/iocf-data.mjs": {
      "maxDuration": 30,
      "includeFiles": "iocf.config.json"
    },
    "api/command-center.mjs": {
      "maxDuration": 15,
      "includeFiles": "src/data/commandCenter/**"
    }
  }
}
